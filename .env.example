# Copie para .env e preencha. O .env está no .gitignore e nunca vai para o Git.

# Chave da API do Devin (v1). Service key começa com apk_, pessoal com apk_user_.
DEVIN_API_KEY=

# Opcionais (valores padrão entre parênteses)
# DEVIN_API_BASE=https://api.devin.ai/v1
# DEVIN_MAX_ACU=2                 # teto por sessão, se o plano respeitar
# DEVIN_INTERVALO_S=3             # intervalo entre consultas de status
# DEVIN_TIMEOUT_RODADA_S=180      # tempo máximo por rodada
# MODO_EXPLORACAO=rodadas         # rodadas | varredura
# SQUAD_PADRAO=cartoes
